# Hypervisor host config: one file per host, named after its short hostname.
# Read by prepare-host.sh and gpu-smoke-vm.sh (HOST_CONFIG overrides the path).
#
# k0s-gpu-01: the example deployment's first host. A desktop with one
# consumer GPU passed through to a VM, a Wi-Fi uplink (so a routed bridge,
# not a LAN bridge), dual-booting Windows.

# banlieue Provider name for this host (one Provider per host, one failure domain).
PROVIDER_NAME=k0s-gpu-01

# The host's VM network: a routed bridge with DHCP, DNS and NAT. Every host
# gets its own non-overlapping subnet (next host: 10.43.0.0/24, ...).
LAB_BRIDGE=br-lab
LAB_ADDR=10.42.0.1/24
LAB_CIDR=10.42.0.0/24

# Ceiling for banlieue-managed guests (sandbox VMs) on this host; the k0s node
# VMs have their own slice.
GUEST_MEMORY_MAX=2G

# GPU passthrough. Every function in the GPU's IOMMU group, as vendor:device
# IDs (lspci -nn -s <slot>), and the slot they share. Leave GPU_PCI_IDS empty
# on a host without a GPU to pass through.
GPU_PCI_IDS="10de:1f02,10de:10f9,10de:1ada,10de:1adb"   # TU106: VGA, audio, USB-C xHCI, UCSI
GPU_PCI_SLOT=0000:01:00
IOMMU=intel            # intel | amd: which <vendor>_iommu=on to set

# Optional host roles.
DUAL_BOOT=true                  # GRUB menu with Windows + helpers/dual-boot/reboot-to-windows
TAILSCALE_SUBNET_ROUTER=true    # advertise LAB_CIDR on the tailnet
