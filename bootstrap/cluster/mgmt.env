# Settings for banlieue's scripts/bootstrap-k0s-cluster.sh (pinned in
# bootstrap-mgmt.sh), which builds the MANAGEMENT cluster's node as a Cloud
# Hypervisor VM made of plain systemd units (banlieue ADR-0099), then installs
# k0s into it with k0sctl. Sourced by that script via BANLIEUE_ENV_FILE.
#
# No secrets here: a lab subnet, a MAC and public pins. (banlieue's own repo
# keeps env files out of git because it is public and names real estates; this
# repo IS the estate.)

# --- Backend and VMM ----------------------------------------------------------
# "libvirt" is the script's local-KVM-host backend; the node itself runs under
# Cloud Hypervisor, so libvirt is never installed or used.
BACKEND=libvirt
DEFAULT_VMM=cloud-hypervisor
CH_BRIDGE=br-lab
# Installed by `banlieue host cloud-hypervisor install` (prepare-host.sh).
CH_FIRMWARE=/opt/banlieue/firmware/ch-97eeb7b09/CLOUDHV.fd
# The VMM's vTPM fix (cloud-hypervisor#9053) isn't released; nothing here needs one.
CH_TPM=false
# The script defaults to libvirt's image pool, which this host doesn't have.
POOL_DIR=/var/lib/homelab/k0s-bootstrap
CH_VM_DIR=/var/lib/homelab/k0s-ch

# --- Image: the same pinned Ubuntu cloud image as the GPU smoke VM ------------
# `cloud` boots a cloud image with cloud-init: no installer, SSH in under a minute.
LIBVIRT_IMAGE_KIND=cloud
CLOUD_IMAGE_URL=https://cloud-images.ubuntu.com/releases/noble/release-20261017/ubuntu-24.04-server-cloudimg-amd64.img
# Reuse the copy gpu-smoke-vm.sh cached and verified (Wi-Fi is slow).
BASE_IMAGE_PATH=/var/lib/homelab/images/ubuntu-24.04-server-cloudimg-amd64.img
# The script verifies cloud images with SHA-512; Ubuntu publishes SHA-256
# (04e8f246...6c94). This SHA-512 was computed from a copy that matched it.
CLOUD_IMAGE_SHA512=a4522881be8c71c3d656a377099055910907f3a35766c55146dc674b38c0704bae6811d89d511ac0d5f485d408708a61080e8b2486978608c9286efa6a4bf039
K0SCTL_OS_OVERRIDE=ubuntu

# --- The node ------------------------------------------------------------------
# One controller+worker: Flux, Cluster API, k0smotron's hosted control planes
# and banlieue run here. Sizing: docs site, "Management plane".
CLUSTER_NAME=homelab-mgmt
VM_PREFIX=mgmt              # -> node mgmt-01
VM_COUNT=1
NODE_ROLES="controller+worker"
NO_TAINTS=true
VCPUS=2
MEM_MB=4608
DISK_GB=40
# Fixed MAC; bootstrap-mgmt.sh gives it a static DHCP lease (MGMT_IP), because
# k0s doesn't survive its node changing address.
VM_MACS="52:54:00:42:00:0b"
MGMT_IP=10.42.0.11

# --- k0s -----------------------------------------------------------------------
# Latest Kubernetes, same minor as kubectl on the host. A running cluster
# upgrades one minor at a time: `bootstrap-mgmt.sh upgrade` walks K0S_UPGRADE_PATH.
# Overridable so `upgrade` can step through K0S_UPGRADE_PATH.
K0S_VERSION="${K0S_VERSION:-1.37.2+k0s.1}"
# Each step is applied in order, skipping any the cluster is already at or past.
K0S_UPGRADE_PATH="1.36.6+k0s.0 1.37.2+k0s.1"
K0S_NETWORK_PROVIDER=kuberouter

# Flux is installed by bootstrap-mgmt.sh (Flux Operator + this repo's
# FluxInstance), not by the script's Vault-based `flux` step.
FLUX_ENABLED=false
