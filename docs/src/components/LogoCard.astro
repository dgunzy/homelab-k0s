---
// A Starlight-style card whose header shows the logos of the projects it's
// about (Starlight's <Card> only takes built-in icons). Use inside <CardGrid>.
interface Logo {
  src: string;
  alt: string;
  /** Single-colour icon drawn in the accent colour. */
  mono?: boolean;
}
interface Props {
  title: string;
  logos: Logo[];
  href?: string;
}
const { title, logos, href } = Astro.props;
const Tag = href ? 'a' : 'article';
---

<Tag class="logo-card not-content" href={href}>
  <div class="logos" aria-hidden="true">
    {
      logos.map((l) =>
        l.mono ? (
          <span class="logo" title={l.alt}>
            <span class="glyph" style={`mask-image:url("${l.src}");-webkit-mask-image:url("${l.src}")`} />
          </span>
        ) : (
          <img class="logo" src={l.src} alt="" title={l.alt} />
        ),
      )
    }
  </div>
  <p class="title">{title}</p>
  <div class="body"><slot /></div>
</Tag>

<style>
  .logo-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: clamp(1rem, calc(0.125rem + 3vw), 2.25rem);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.9rem;
    background-color: var(--sl-color-black);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, transform 0.15s;
  }
  .logo-card:hover {
    border-color: color-mix(in srgb, var(--sl-color-accent) 55%, var(--sl-color-gray-5));
    transform: translateY(-2px);
  }
  .logos {
    display: flex;
    gap: 0.5rem;
  }
  .logo {
    width: 2.6rem;
    height: 2.6rem;
    padding: 0.45rem;
    box-sizing: border-box;
    object-fit: contain;
    border-radius: 0.6rem;
    border: 1px solid color-mix(in srgb, var(--sl-color-accent) 45%, transparent);
    background-color: var(--sl-color-accent-low);
  }
  /* Full-colour project logos are mostly designed for dark backgrounds: keep
     their tile dark in both themes. Mono icons use the accent tile. */
  img.logo {
    background-color: #0f172a;
  }
  span.logo {
    display: block;
  }
  .glyph {
    display: block;
    width: 100%;
    height: 100%;
    background-color: var(--sl-color-accent-high);
    mask-size: contain;
    mask-repeat: no-repeat;
    mask-position: center;
    -webkit-mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-position: center;
  }
  .title {
    margin: 0;
    font-family: var(--heading-font, inherit);
    font-size: var(--sl-text-h4);
    font-weight: 600;
    line-height: var(--sl-line-height-headings);
    color: var(--sl-color-white);
  }
  .body {
    margin: 0;
    font-size: clamp(var(--sl-text-sm), calc(0.5rem + 1vw), var(--sl-text-body));
    color: var(--sl-color-gray-2);
  }
  .body :global(p) {
    margin: 0;
  }
</style>
